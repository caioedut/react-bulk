{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./*"
      ],
      "@react-bulk/core": [
        "../../packages/core/src"
      ],
      "@react-bulk/expo": [
        "../../packages/expo/src"
      ],
      "@react-bulk/native": [
        "../../packages/native/src"
      ],
      "@react-bulk/web": [
        "../../packages/web/src"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
